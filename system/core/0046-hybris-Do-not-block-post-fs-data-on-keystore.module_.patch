From 954d6a44f18e716fb48780f711b4003beacac59b Mon Sep 17 00:00:00 2001
From: Nikola <bigisoft@gmail.com>
Date: Thu, 10 Sep 2026 13:07:54 +0200
Subject: [PATCH] (hybris) Do not block post-fs-data on
 keystore.module_hash.sent

wait_for_prop has no timeout. If keystore2 fails to start, post-fs-data
blocks for ever, and perform_apex_config is the next line - so no APEX .rc
is parsed, /linkerconfig/ld.config.txt stays the 1-byte stub, the linker
can find no HAL, and lipstick dies with

  library "hwcomposer.qcom.so" not found

leaving the device on the vendor splash with no UI. Observed on sweet: one
boot in four came up dead this way, and every one of them had keystore2
exiting status 1 in a restart loop.

Upstream only wants the wait so APEX module measurement is not disturbed at
attestation time. That is not worth trading the entire UI for on a port
that has no KeyMint AIDL at all.

Change-Id: I2c103c87e4ac6db8cffa5af9fcfdac4dfd1a6ac0
---
 rootdir/init.rc | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index a4e163f01..c05fdccb1 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -1070,9 +1070,24 @@ on post-fs-data
 
     # TODO(b/400439023): Remove once attest modules flagging is removed.
     wait_for_prop apexd.status activated
-    # Wait for KeyMints to receive APEX module info before starting code from updateable APEXes.
-    # This is to prevent APEX modules from interfering in module measurement.
-    wait_for_prop keystore.module_hash.sent true
+    # (hybris) Upstream waits here for keystore to report APEX module hashes to
+    # KeyMint, so that module measurement is not disturbed:
+    #
+    #     wait_for_prop keystore.module_hash.sent true
+    #
+    # wait_for_prop has no timeout, so on a device where keystore2 fails to
+    # start this blocks post-fs-data for ever - and perform_apex_config is the
+    # very next line. That call is what parses every APEX .rc file, generates
+    # /linkerconfig/ld.config.txt and marks the default mount namespace ready.
+    # Losing it leaves the 1-byte stub config behind, so the linker cannot find
+    # any HAL, lipstick fails with `library "hwcomposer.qcom.so" not found`,
+    # and the device sits on the vendor splash with no UI.
+    #
+    # That turned a keystore2 hiccup into an unbootable phone, and keystore2
+    # does intermittently exit 1 on this device. Attestation-time module
+    # measurement is not worth the whole UI, so the wait is dropped here: when
+    # keystore2 starts normally it still sets the property, just without
+    # holding the boot hostage when it does not.
     perform_apex_config
 
     start system_aconfigd_socket_service
-- 
2.43.0

