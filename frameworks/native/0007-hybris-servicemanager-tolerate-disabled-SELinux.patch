     selinux_set_callback(SELINUX_CB_LOG, cb);
 
-    CHECK(selinux_status_open(true /*fallback*/) >= 0);
+    gHybrisSelinuxAvailable = (selinux_status_open(true /*fallback*/) >= 0) &&
+                              (getcon(&mThisProcessContext) == 0);
 
-    CHECK(getcon(&mThisProcessContext) == 0);
+    if (!gHybrisSelinuxAvailable) {
+        LOG(WARNING) << "(hybris) SELinux unavailable; service_manager access "
+                        "checks will allow all actions";
+        mThisProcessContext = nullptr;
+    }
 #endif
 }
 
