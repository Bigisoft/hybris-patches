+// (hybris) SELinux is disabled on a Sailfish OS port, see hybris-patches
+// system/core/0017-hybris-Disable-SELinux. The stock constructor CHECK()s the
+// SELinux setup and aborts when it fails, which kills servicemanager and
+// vndservicemanager on every start:
+//     #04 android::Access::Access()+212  /vendor/bin/vndservicemanager
+//     #01 android::base::DefaultAborter  libbase.so
+// Everything binder-based depends on those two, so init restarts the whole
+// service class in a loop and the device never finishes booting.
+//
+// Treat an unavailable SELinux the way this file already treats a non-Android
+// build: allow every action. That is the only sane policy when there is no
+// policy engine to consult.
+static bool gHybrisSelinuxAvailable = false;
+
 Access::Access() {
 #ifdef __ANDROID__
     union selinux_callback cb;
@@ -100,9 +114,14 @@ Access::Access() {
